/* ═══════════════════════════════════════════
   Animated Number — count-up animation
   ═══════════════════════════════════════════ */
function AnimatedNumber({ value, duration = 1200 }: { value: number; duration?: number }) {
  const [display, setDisplay] = useState(0);
  const ref = useRef(value);
  const rafRef = useRef<number>(0);

  useEffect(() => {
    const start = ref.current;
    const end = value;
    const startTime = performance.now();
    const diff = end - start;

    function tick(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // ease-out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      setDisplay(Math.round(start + diff * eased));
      if (progress < 1) {
        rafRef.current = requestAnimationFrame(tick);
      }
    }
    rafRef.current = requestAnimationFrame(tick);
    ref.current = value;
    return () => cancelAnimationFrame(rafRef.current);
  }, [value, duration]);

  return <>{display.toLocaleString('id-ID')}</>;
}

/* ═══════════════════════════════════════════
   Section wrapper with staggered reveal
   ═══════════════════════════════════════════ */
const sectionVariants = {
  hidden: { opacity: 0, y: 24 },
  visible: { opacity: 1, y: 0, transition: { duration: 0.5, ease: 'easeOut' } },
};

function Section({ children, className = '' }: { children: React.ReactNode; className?: string }) {
  return (
    <motion.section
      variants={sectionVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true, margin: '-40px' }}
      className={className}
    >
      {children}
    </motion.section>
  );
}

/* ═══════════════════════════════════════════
   1. Community Hero
   ═══════════════════════════════════════════ */
function CommunityHero({
  maleData,
  femaleData,
  leagueData,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
  leagueData?: { stats?: { totalClubs: number; totalMatches: number; completedMatches: number; liveMatches: number } };
}) {
  const totalPlayers = (maleData?.totalPlayers || 0) + (femaleData?.totalPlayers || 0);
  const totalClubs = leagueData?.stats?.totalClubs || 0;
  const hasLive = maleData?.activeTournament?.status === 'live' || femaleData?.activeTournament?.status === 'live';
  const activeTournaments = [maleData?.activeTournament, femaleData?.activeTournament].filter(Boolean).length;

  return (
    <div className="relative overflow-hidden rounded-2xl bg-gradient-to-br from-idm-gold-warm/20 via-idm-gold/10 to-transparent border border-idm-gold-warm/20 p-6 sm:p-8">
      {/* Decorative blur circles */}
      <div className="absolute -top-20 -right-20 w-60 h-60 rounded-full bg-idm-gold-warm/10 blur-3xl pointer-events-none" />
      <div className="absolute -bottom-16 -left-16 w-48 h-48 rounded-full bg-idm-gold/10 blur-3xl pointer-events-none" />

      {/* Dot pattern overlay */}
      <div className="absolute inset-0 opacity-[0.03]" style={{
        backgroundImage: 'radial-gradient(circle, currentColor 1px, transparent 1px)',
        backgroundSize: '24px 24px',
      }} />

      <div className="relative z-10">
        {/* Live badge */}
        {hasLive && (
          <motion.div
            initial={{ opacity: 0, scale: 0.8 }}
            animate={{ opacity: 1, scale: 1 }}
            className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-red-500/15 border border-red-500/30 mb-4"
          >
            <span className="relative flex h-2 w-2">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75" />
              <span className="relative inline-flex rounded-full h-2 w-2 bg-red-500" />
            </span>
            <span className="text-[11px] font-bold text-red-400 uppercase tracking-wider">LIVE</span>
          </motion.div>
        )}

        {/* Title */}
        <h1 className="text-3xl sm:text-4xl font-black tracking-tight">
          <span className="bg-gradient-to-r from-idm-gold-warm to-idm-gold bg-clip-text text-transparent">
            IDM TARKAM
          </span>
        </h1>
        <p className="text-muted-foreground text-sm sm:text-base mt-1">
          Indonesian Dance Match
        </p>

        {/* Quick stats row */}
        <div className="flex flex-wrap items-center gap-4 mt-5 text-xs sm:text-sm">
          <div className="flex items-center gap-1.5 text-idm-gold-warm">
            <Users className="w-4 h-4" />
            <span className="font-bold"><AnimatedNumber value={totalPlayers} /></span>
            <span className="text-muted-foreground">Pemain</span>
          </div>
          <div className="flex items-center gap-1.5 text-idm-gold-warm">
            <Building2 className="w-4 h-4" />
            <span className="font-bold"><AnimatedNumber value={totalClubs} /></span>
            <span className="text-muted-foreground">Klub</span>
          </div>
          <div className="flex items-center gap-1.5 text-idm-gold-warm">
            <Gamepad2 className="w-4 h-4" />
            <span className="font-bold">{activeTournaments}</span>
            <span className="text-muted-foreground">Turnamen Aktif</span>
          </div>
        </div>
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════
   2. Community Stats — 4 cards
   ═══════════════════════════════════════════ */
function CommunityStats({
  maleData,
  femaleData,
  leagueData,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
  leagueData?: { stats?: { totalClubs: number; totalMatches: number; completedMatches: number; liveMatches: number } };
}) {
  const dt = useDivisionTheme();
  const totalPlayers = (maleData?.totalPlayers || 0) + (femaleData?.totalPlayers || 0);
  const totalClubs = leagueData?.stats?.totalClubs || 0;
  const totalMatches = leagueData?.stats?.totalMatches || 0;
  const activeTournaments = [maleData?.activeTournament, femaleData?.activeTournament].filter(Boolean).length;

  const stats = [
    { icon: Users, label: 'Total Pemain', value: totalPlayers, gradient: 'from-idm-gold-warm to-amber-500', iconBg: 'bg-idm-gold-warm/15 text-idm-gold-warm' },
    { icon: Building2, label: 'Total Club', value: totalClubs, gradient: 'from-emerald-500 to-green-400', iconBg: 'bg-emerald-500/15 text-emerald-500' },
    { icon: Swords, label: 'Total Pertandingan', value: totalMatches, gradient: 'from-idm-male to-idm-male-light', iconBg: 'bg-idm-male/15 text-idm-male' },
    { icon: Trophy, label: 'Turnamen Aktif', value: activeTournaments, gradient: 'from-idm-female to-idm-female-light', iconBg: 'bg-idm-female/15 text-idm-female' },
  ];

  return (
    <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
      {stats.map((stat, i) => (
        <motion.div
          key={stat.label}
          initial={{ opacity: 0, y: 16 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ delay: i * 0.08, duration: 0.4 }}
        >
          <Card className={`${dt.cardPremium} overflow-hidden group`}>
            <CardContent className="p-4 text-center">
              <div className={`w-9 h-9 rounded-xl ${stat.iconBg} flex items-center justify-center mx-auto mb-2.5`}>
                <stat.icon className="w-4.5 h-4.5" />
              </div>
              <p className={`text-2xl font-black bg-gradient-to-r ${stat.gradient} bg-clip-text text-transparent`}>
                <AnimatedNumber value={stat.value} />
              </p>
              <p className="text-[10px] text-muted-foreground uppercase tracking-wider font-semibold mt-1">{stat.label}</p>
            </CardContent>
          </Card>
        </motion.div>
      ))}
    </div>
  );
}

/* ═══════════════════════════════════════════
   3. Division Showcase — Male & Female cards
   ═══════════════════════════════════════════ */
function DivisionShowcase({
  maleData,
  femaleData,
  onEnterDivision,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
  onEnterDivision: (d: 'male' | 'female') => void;
}) {
  const divisions = [
    {
      key: 'male' as const,
      label: 'Male Tarkam',
      emoji: '🕺',
      data: maleData,
      colorFrom: 'from-idm-male/20',
      colorTo: 'to-idm-male-light/5',
      border: 'border-idm-male/25',
      textAccent: 'text-idm-male',
      badgeBg: 'bg-idm-male/15 text-idm-male border-idm-male/30',
      btnBg: 'bg-gradient-to-r from-idm-male to-idm-male-light',
    },
    {
      key: 'female' as const,
      label: 'Female Tarkam',
      emoji: '💃',
      data: femaleData,
      colorFrom: 'from-idm-female/20',
      colorTo: 'to-idm-female-light/5',
      border: 'border-idm-female/25',
      textAccent: 'text-idm-female',
      badgeBg: 'bg-idm-female/15 text-idm-female border-idm-female/30',
      btnBg: 'bg-gradient-to-r from-idm-female to-idm-female-light',
    },
  ];

  return (
    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {divisions.map((div, i) => {
        const isLive = div.data?.activeTournament?.status === 'live';
        const playerCount = div.data?.totalPlayers || 0;
        const topPlayer = div.data?.topPlayers?.[0];

        return (
          <motion.div
            key={div.key}
            initial={{ opacity: 0, x: div.key === 'male' ? -20 : 20 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ delay: i * 0.1, duration: 0.5 }}
          >
            <Card
              className={`bg-gradient-to-br ${div.colorFrom} ${div.colorTo} ${div.border} border cursor-pointer group overflow-hidden transition-all duration-300 hover:shadow-lg hover:scale-[1.01]`}
              onClick={() => onEnterDivision(div.key)}
            >
              <CardContent className="p-5">
                {/* Header */}
                <div className="flex items-center justify-between mb-3">
                  <div className="flex items-center gap-2">
                    <span className="text-2xl">{div.emoji}</span>
                    <h3 className={`text-lg font-bold ${div.textAccent}`}>{div.label}</h3>
                  </div>
                  {isLive && (
                    <Badge className={`${div.badgeBg} text-[9px] border`}>
                      <span className="relative flex h-1.5 w-1.5 mr-1">
                        <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75" />
                        <span className="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-500" />
                      </span>
                      LIVE
                    </Badge>
                  )}
                </div>

                {/* Stats row */}
                <div className="flex items-center gap-4 text-xs text-muted-foreground mb-4">
                  <span className="flex items-center gap-1"><Users className="w-3.5 h-3.5" /> {playerCount} Pemain</span>
                  {div.data?.activeTournament && (
                    <span className="flex items-center gap-1"><Trophy className="w-3.5 h-3.5" /> {div.data.activeTournament.name}</span>
                  )}
                </div>

                {/* Top player preview */}
                {topPlayer && (
                  <div className="flex items-center gap-2.5 p-2.5 rounded-lg bg-background/40 border border-border/30 mb-3">
                    <div className={`w-8 h-8 rounded-full overflow-hidden ring-1 ${div.key === 'male' ? 'ring-idm-male/30' : 'ring-idm-female/30'} shrink-0`}>
                      <Image
                        src={getAvatarUrl(topPlayer.gamertag, div.key, topPlayer.avatar)}
                        alt={topPlayer.gamertag}
                        width={32}
                        height={32}
                        className="w-full h-full object-cover"
                      />
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-xs font-semibold truncate">{topPlayer.gamertag}</p>
                      <p className="text-[10px] text-muted-foreground truncate">
                        {clubToString(topPlayer.club as Parameters<typeof clubToString>[0]) || '—'} • {topPlayer.points} pts
                      </p>
                    </div>
                    <TierBadge tier={topPlayer.tier} />
                  </div>
                )}

                {/* CTA */}
                <div className="flex items-center justify-end">
                  <span className={`${div.btnBg} text-white text-xs font-semibold px-4 py-2 rounded-lg flex items-center gap-1.5 group-hover:shadow-md transition-shadow`}>
                    Masuk <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                  </span>
                </div>
              </CardContent>
            </Card>
          </motion.div>
        );
      })}
    </div>
  );
}

/* ═══════════════════════════════════════════
   4. Community Champions — Podium layout
   ═══════════════════════════════════════════ */
function CommunityChampions({
  maleData,
  femaleData,
  onPlayerClick,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
  onPlayerClick: (player: TopPlayer & { division?: string }, division: 'male' | 'female') => void;
}) {
  const maleTop3 = (maleData?.topPlayers || []).slice(0, 3);
  const femaleTop3 = (femaleData?.topPlayers || []).slice(0, 3);

  return (
    <div className="space-y-6">
      {/* Male Champions */}
      {maleTop3.length > 0 && (
        <div>
          <div className="flex items-center gap-2 mb-3">
            <span className="text-lg">🕺</span>
            <h3 className="text-sm font-bold text-idm-male uppercase tracking-wider">Male Champions</h3>
          </div>
          <PodiumDisplay players={maleTop3} division="male" onPlayerClick={onPlayerClick} />
        </div>
      )}

      {/* Female Champions */}
      {femaleTop3.length > 0 && (
        <div>
          <div className="flex items-center gap-2 mb-3">
            <span className="text-lg">💃</span>
            <h3 className="text-sm font-bold text-idm-female uppercase tracking-wider">Female Champions</h3>
          </div>
          <PodiumDisplay players={femaleTop3} division="female" onPlayerClick={onPlayerClick} />
        </div>
      )}
    </div>
  );
}

/* Podium display: 2nd - 1st - 3rd */
function PodiumDisplay({
  players,
  division,
  onPlayerClick,
}: {
  players: TopPlayer[];
  division: 'male' | 'female';
  onPlayerClick: (player: TopPlayer & { division?: string }, division: 'male' | 'female') => void;
}) {
  const dt = getDivisionTheme(division);
  const podiumOrder = [players[1], players[0], players[2]].filter(Boolean); // 2nd, 1st, 3rd
  const heights = ['h-24', 'h-32', 'h-20'];
  const medals = [
    { icon: Medal, color: 'text-gray-400', bg: 'bg-gray-400/15' },
    { icon: Crown, color: 'text-yellow-500', bg: 'bg-yellow-500/15' },
    { icon: Medal, color: 'text-amber-600', bg: 'bg-amber-600/15' },
  ];

  return (
    <div className="flex items-end justify-center gap-3">
      {podiumOrder.map((player, i) => {
        const rank = i === 1 ? 1 : i === 0 ? 2 : 3;
        const medal = medals[i];
        const MedalIcon = medal.icon;

        return (
          <motion.div
            key={player.id}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ delay: i * 0.1, duration: 0.4 }}
            className="flex flex-col items-center cursor-pointer group"
            onClick={() => onPlayerClick({ ...player, division }, division)}
          >
            {/* Avatar */}
            <div className={`relative w-14 h-14 rounded-full overflow-hidden ring-2 ${
              rank === 1 ? 'ring-yellow-500/50 shadow-lg shadow-yellow-500/20' : 'ring-border/30'
            } mb-1.5 group-hover:scale-105 transition-transform`}>
              <Image
                src={getAvatarUrl(player.gamertag, division, player.avatar)}
                alt={player.gamertag}
                width={56}
                height={56}
                className="w-full h-full object-cover"
              />
              {/* Rank badge */}
              <div className={`absolute -bottom-1 -right-1 w-5 h-5 rounded-full ${medal.bg} flex items-center justify-center`}>
                <MedalIcon className={`w-3 h-3 ${medal.color}`} />
              </div>
            </div>

            {/* Name */}
            <p className="text-xs font-bold text-center max-w-[80px] truncate">{player.gamertag}</p>
            <p className="text-[9px] text-muted-foreground text-center max-w-[80px] truncate">
              {clubToString(player.club as Parameters<typeof clubToString>[0]) || '—'}
            </p>

            {/* Points */}
            <p className={`text-[10px] font-bold ${dt.text} mt-0.5`}>{player.points} pts</p>

            {/* Tier badge */}
            <TierBadge tier={player.tier} />

            {/* Podium block */}
            <div className={`${heights[i]} w-16 sm:w-20 rounded-t-lg ${dt.bgSubtle} border ${dt.borderSubtle} mt-1.5 flex items-center justify-center`}>
              <span className={`text-2xl font-black ${rank === 1 ? 'text-yellow-500' : 'text-muted-foreground/40'}`}>#{rank}</span>
            </div>
          </motion.div>
        );
      })}
    </div>
  );
}

/* ═══════════════════════════════════════════
   5. Community Leaderboard — Tabs: Pemain / Klub
   ═══════════════════════════════════════════ */
function CommunityLeaderboard({
  maleData,
  femaleData,
  leagueData,
  onPlayerClick,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
  leagueData?: {
    clubs?: Array<{
      id: string;
      name: string;
      logo?: string | null;
      wins: number;
      losses: number;
      points: number;
      gameDiff: number;
      memberCount: number;
    }>;
  };
  onPlayerClick: (player: TopPlayer & { division?: string }, division: 'male' | 'female') => void;
}) {
  const dt = useDivisionTheme();

  // Merge top players from both divisions, re-sort by points
  const mergedPlayers = useMemo(() => {
    const male = (maleData?.topPlayers || []).map(p => ({ ...p, division: 'male' as const }));
    const female = (femaleData?.topPlayers || []).map(p => ({ ...p, division: 'female' as const }));
    return [...male, ...female].sort((a, b) => b.points - a.points);
  }, [maleData, femaleData]);

  const clubs = leagueData?.clubs || [];

  return (
    <Card className={`${dt.cardPremium} overflow-hidden`}>
      <CardContent className="p-0">
        <Tabs defaultValue="players" className="w-full">
          <div className={`px-4 pt-4 pb-2 border-b ${dt.borderSubtle}`}>
            <TabsList className="bg-muted/50">
              <TabsTrigger value="players" className="text-xs">
                <Users className="w-3.5 h-3.5 mr-1.5" /> Pemain
              </TabsTrigger>
              <TabsTrigger value="clubs" className="text-xs">
                <Building2 className="w-3.5 h-3.5 mr-1.5" /> Klub
              </TabsTrigger>
            </TabsList>
          </div>

          {/* Players tab */}
          <TabsContent value="players" className="m-0">
            <div className="max-h-96 overflow-y-auto custom-scrollbar">
              <Table>
                <TableHeader>
                  <TableRow className="hover:bg-transparent">
                    <TableHead className="w-10 text-[10px]">#</TableHead>
                    <TableHead className="text-[10px]">Pemain</TableHead>
                    <TableHead className="w-16 text-[10px] text-center">Tier</TableHead>
                    <TableHead className="w-20 text-[10px] text-center">Divisi</TableHead>
                    <TableHead className="w-14 text-[10px] text-right">Poin</TableHead>
                    <TableHead className="w-16 text-[10px] text-right hidden sm:table-cell">W/L</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {mergedPlayers.slice(0, 20).map((player, idx) => {
                    const rank = idx + 1;
                    const playerDivision = (player.division || 'male') as 'male' | 'female';
                    const playerDt = getDivisionTheme(playerDivision);
                    const losses = player.matches - player.totalWins;

                    return (
                      <TableRow
                        key={player.id}
                        className="cursor-pointer hover:bg-muted/30 transition-colors"
                        onClick={() => onPlayerClick(player, playerDivision)}
                      >
                        <TableCell className="text-xs font-bold">
                          {rank <= 3 ? (
                            <span className={`inline-flex items-center justify-center w-5 h-5 rounded-full ${
                              rank === 1 ? 'bg-yellow-500/20 text-yellow-500' :
                              rank === 2 ? 'bg-gray-400/20 text-gray-400' :
                              'bg-amber-600/20 text-amber-600'
                            } text-[10px]`}>
                              {rank === 1 ? '👑' : rank}
                            </span>
                          ) : (
                            <span className="text-muted-foreground">{rank}</span>
                          )}
                        </TableCell>
                        <TableCell>
                          <div className="flex items-center gap-2">
                            <div className={`w-7 h-7 rounded-full overflow-hidden shrink-0 ${rank <= 3 ? 'ring-1 ring-yellow-500/30' : ''}`}>
                              <Image
                                src={getAvatarUrl(player.gamertag, playerDivision, player.avatar)}
                                alt={player.gamertag}
                                width={28}
                                height={28}
                                className="w-full h-full object-cover"
                              />
                            </div>
                            <div className="min-w-0">
                              <p className="text-xs font-semibold truncate">{player.gamertag}</p>
                              <p className="text-[9px] text-muted-foreground truncate">
                                {clubToString(player.club as Parameters<typeof clubToString>[0]) || '—'}
                              </p>
                            </div>
                          </div>
                        </TableCell>
                        <TableCell className="text-center"><TierBadge tier={player.tier} /></TableCell>
                        <TableCell className="text-center">
                          <Badge className={`${playerDt.badgeBg} text-[8px] border`}>
                            {playerDivision === 'male' ? '🕺 Male' : '💃 Female'}
                          </Badge>
                        </TableCell>
                        <TableCell className="text-right text-xs font-bold">{player.points}</TableCell>
                        <TableCell className="text-right text-[10px] hidden sm:table-cell">
                          <span className="text-green-500">{player.totalWins}W</span>
                          <span className="text-muted-foreground mx-0.5">/</span>
                          <span className="text-red-500">{losses}L</span>
                        </TableCell>
                      </TableRow>
                    );
                  })}
                </TableBody>
              </Table>
            </div>
          </TabsContent>

          {/* Clubs tab */}
          <TabsContent value="clubs" className="m-0">
            <div className="max-h-96 overflow-y-auto custom-scrollbar">
              <Table>
                <TableHeader>
                  <TableRow className="hover:bg-transparent">
                    <TableHead className="w-10 text-[10px]">#</TableHead>
                    <TableHead className="text-[10px]">Klub</TableHead>
                    <TableHead className="w-14 text-[10px] text-right">Poin</TableHead>
                    <TableHead className="w-16 text-[10px] text-right">W/L</TableHead>
                    <TableHead className="w-14 text-[10px] text-right hidden sm:table-cell">GD</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {clubs.slice(0, 20).map((club, idx) => (
                    <TableRow key={club.id} className="hover:bg-muted/30 transition-colors">
                      <TableCell className="text-xs font-bold text-muted-foreground">{idx + 1}</TableCell>
                      <TableCell>
                        <div className="flex items-center gap-2">
                          <div className="w-7 h-7 rounded-full overflow-hidden bg-muted shrink-0">
                            {club.logo ? (
                              <Image src={club.logo} alt={club.name} width={28} height={28} className="w-full h-full object-cover" />
                            ) : (
                              <div className="w-full h-full flex items-center justify-center text-[9px] font-bold text-muted-foreground">
                                {club.name.slice(0, 2).toUpperCase()}
                              </div>
                            )}
                          </div>
                          <span className="text-xs font-semibold truncate">{club.name}</span>
                        </div>
                      </TableCell>
                      <TableCell className="text-right text-xs font-bold">{club.points}</TableCell>
                      <TableCell className="text-right text-[10px]">
                        <span className="text-green-500">{club.wins}W</span>
                        <span className="text-muted-foreground mx-0.5">/</span>
                        <span className="text-red-500">{club.losses}L</span>
                      </TableCell>
                      <TableCell className="text-right text-[10px] hidden sm:table-cell">
                        <span className={club.gameDiff > 0 ? 'text-green-500' : club.gameDiff < 0 ? 'text-red-500' : 'text-muted-foreground'}>
                          {club.gameDiff > 0 ? '+' : ''}{club.gameDiff}
                        </span>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          </TabsContent>
        </Tabs>
      </CardContent>
    </Card>
  );
}

/* ═══════════════════════════════════════════
   6. Community Gallery — Horizontal scrollable
   ═══════════════════════════════════════════ */
function CommunityGallery({
  maleData,
  femaleData,
}: {
  maleData?: StatsData;
  femaleData?: StatsData;
}) {
  const cards = useMemo(() => {
    const items: Array<{
      id: string;
      title: string;
      desc: string;
      badge?: string;
      emoji: string;
      gradient: string;
    }> = [];

    // Active tournaments
    for (const [div, data] of [['male', maleData], ['female', femaleData]] as const) {
      if (data?.activeTournament) {
        const t = data.activeTournament;
        items.push({
          id: `tournament-${div}`,
          title: t.name,
          desc: `Week ${t.weekNumber} • ${t.teams?.length || 0} Tim`,
          badge: t.status === 'live' ? '🔴 LIVE' : t.status,
          emoji: div === 'male' ? '🕺' : '💃',
          gradient: div === 'male'
            ? 'from-idm-male/30 to-idm-male-light/10'
            : 'from-idm-female/30 to-idm-female-light/10',
        });
      }
    }

    // Top players featured cards
    for (const [div, data] of [['male', maleData], ['female', femaleData]] as const) {
      const top3 = data?.topPlayers?.slice(0, 3) || [];
      if (top3.length > 0) {
        items.push({
          id: `top-${div}`,
          title: `Top ${div === 'male' ? 'Male' : 'Female'}`,
          desc: top3.map(p => p.gamertag).join(' • '),
          badge: `${top3.length} Pemain`,
          emoji: div === 'male' ? '🏆' : '🌟',
          gradient: 'from-idm-gold-warm/25 to-amber-500/10',
        });
      }
    }

    // Weekly champions
    for (const [div, data] of [['male', maleData], ['female', femaleData]] as const) {
      const champions = data?.weeklyChampions?.slice(0, 2) || [];
      for (const ch of champions) {
        if (ch.winnerTeam) {
          items.push({
            id: `champion-${ch.weekNumber}-${div}`,
            title: `W${ch.weekNumber} Champion`,
            desc: ch.winnerTeam.name,
            emoji: '👑',
            gradient: 'from-yellow-500/20 to-amber-600/10',
          });
        }
      }
    }

    return items;
  }, [maleData, femaleData]);

  if (cards.length === 0) return null;

  return (
    <div className="relative">
      <div className="flex gap-3 overflow-x-auto snap-x snap-mandatory pb-2 custom-scrollbar" style={{ scrollbarWidth: 'none' }}>
        {cards.map((card, i) => (
          <motion.div
            key={card.id}
            initial={{ opacity: 0, scale: 0.95 }}
            whileInView={{ opacity: 1, scale: 1 }}
            viewport={{ once: true }}
            transition={{ delay: i * 0.05, duration: 0.3 }}
            className="snap-start shrink-0 w-56"
          >
            <Card className={`bg-gradient-to-br ${card.gradient} border border-border/20 overflow-hidden group hover:shadow-md transition-shadow h-full`}>
              <CardContent className="p-4 flex flex-col h-full">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xl">{card.emoji}</span>
                  {card.badge && (
                    <Badge variant="secondary" className="text-[8px] font-bold">{card.badge}</Badge>
                  )}
                </div>
                <h4 className="text-xs font-bold mb-1 line-clamp-1">{card.title}</h4>
                <p className="text-[10px] text-muted-foreground line-clamp-2 flex-1">{card.desc}</p>
              </CardContent>
            </Card>
          </motion.div>
        ))}
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════
   Loading Skeleton
   ═══════════════════════════════════════════ */
function CommunityDashboardSkeleton() {
  return (
    <div className="space-y-6 animate-pulse">
      {/* Hero skeleton */}
      <div className="rounded-2xl bg-muted/20 border border-border/20 p-8">
        <Skeleton className="h-6 w-20 rounded-full mb-4" />
        <Skeleton className="h-9 w-48 mb-2" />
        <Skeleton className="h-5 w-36 mb-4" />
        <div className="flex gap-6">
          <Skeleton className="h-4 w-24" />
          <Skeleton className="h-4 w-24" />
          <Skeleton className="h-4 w-28" />
        </div>
      </div>

      {/* Stats skeleton */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
        {Array.from({ length: 4 }).map((_, i) => (
          <div key={i} className="rounded-xl border border-border/20 bg-muted/10 p-4 text-center">
            <Skeleton className="w-9 h-9 rounded-xl mx-auto mb-2" />
            <Skeleton className="h-7 w-12 mx-auto mb-1" />
            <Skeleton className="h-3 w-16 mx-auto" />
          </div>
        ))}
      </div>

      {/* Division skeleton */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {Array.from({ length: 2 }).map((_, i) => (
          <div key={i} className="rounded-xl border border-border/20 bg-muted/10 p-5">
            <div className="flex items-center gap-2 mb-3">
              <Skeleton className="w-8 h-8 rounded-lg" />
              <Skeleton className="h-5 w-28" />
            </div>
            <Skeleton className="h-4 w-20 mb-3" />
            <Skeleton className="h-12 w-full rounded-lg mb-3" />
            <div className="flex justify-end"><Skeleton className="h-8 w-20 rounded-lg" /></div>
          </div>
        ))}
      </div>
    </div>
  );
}

/* ═══════════════════════════════════════════
   Main Community Dashboard
   ═══════════════════════════════════════════ */
export function CommunityDashboard() {
  const { setDivision, setCurrentView } = useAppStore();
  const dt = useDivisionTheme();

  // Selected player for profile modal
  const [selectedPlayer, setSelectedPlayer] = useState<(TopPlayer & { division?: string }) | null>(null);

  // Fetch male stats
  const { data: maleData, isLoading: isMaleLoading } = useQuery<StatsData>({
    queryKey: ['stats', 'male'],
    queryFn: async () => {
      const res = await fetch('/api/stats?division=male');
      return res.json();
    },
    staleTime: 15000,
    refetchInterval: 30000,
    refetchOnWindowFocus: true,
  });

  // Fetch female stats
  const { data: femaleData, isLoading: isFemaleLoading } = useQuery<StatsData>({
    queryKey: ['stats', 'female'],
    queryFn: async () => {
      const res = await fetch('/api/stats?division=female');
      return res.json();
    },
    staleTime: 15000,
    refetchInterval: 30000,
    refetchOnWindowFocus: true,
  });

  // Fetch league data
  const { data: leagueData, isLoading: isLeagueLoading } = useQuery<{
    hasData: boolean;
    stats?: { totalClubs: number; totalMatches: number; completedMatches: number; liveMatches: number };
    clubs?: Array<{
      id: string;
      name: string;
      logo?: string | null;
      wins: number;
      losses: number;
      points: number;
      gameDiff: number;
      memberCount: number;
    }>;
  }>({
    queryKey: ['league-community'],
    queryFn: async () => {
      const res = await fetch('/api/league');
      return res.json();
    },
    staleTime: 15000,
    refetchInterval: 30000,
    refetchOnWindowFocus: true,
  });

  const isLoading = isMaleLoading || isFemaleLoading || isLeagueLoading;

  // Navigation handler
  const enterDivision = (division: 'male' | 'female') => {
    setDivision(division);
    setCurrentView('dashboard');
  };

  // Player click handler
  const handlePlayerClick = (player: TopPlayer & { division?: string }, division: 'male' | 'female') => {
    setSelectedPlayer({ ...player, division });
  };

  if (isLoading) {
    return <CommunityDashboardSkeleton />;
  }

  return (
    <div className="space-y-6">
      {/* 1. Community Hero */}
      <Section>
        <CommunityHero maleData={maleData} femaleData={femaleData} leagueData={leagueData} />
      </Section>

      {/* 2. Community Stats */}
      <Section>
        <CommunityStats maleData={maleData} femaleData={femaleData} leagueData={leagueData} />
      </Section>

      {/* 3. Division Showcase */}
      <Section>
        <div className="flex items-center gap-2 mb-3">
          <Swords className={`w-4 h-4 ${dt.text}`} />
          <h2 className="text-sm font-bold uppercase tracking-wider">Pilih Divisi</h2>
        </div>
        <DivisionShowcase maleData={maleData} femaleData={femaleData} onEnterDivision={enterDivision} />
      </Section>

      {/* 4. Community Champions */}
      <Section>
        <div className="flex items-center gap-2 mb-3">
          <Crown className="w-4 h-4 text-yellow-500" />
          <h2 className="text-sm font-bold uppercase tracking-wider">Champions</h2>
        </div>
        <CommunityChampions maleData={maleData} femaleData={femaleData} onPlayerClick={handlePlayerClick} />
      </Section>

      {/* 5. Community Leaderboard */}
      <Section>
        <div className="flex items-center gap-2 mb-3">
          <Flame className={`w-4 h-4 ${dt.text}`} />
          <h2 className="text-sm font-bold uppercase tracking-wider">Peringkat</h2>
        </div>
        <CommunityLeaderboard
          maleData={maleData}
          femaleData={femaleData}
          leagueData={leagueData}
          onPlayerClick={handlePlayerClick}
        />
      </Section>

      {/* 6. Community Gallery */}
      <Section>
        <div className="flex items-center gap-2 mb-3">
          <Star className="w-4 h-4 text-idm-gold-warm" />
          <h2 className="text-sm font-bold uppercase tracking-wider">Galeri Komunitas</h2>
        </div>
        <CommunityGallery maleData={maleData} femaleData={femaleData} />
      </Section>

      {/* Player Profile Modal */}
      {selectedPlayer && (
        <PlayerProfileModal
          player={selectedPlayer}
          onClose={() => setSelectedPlayer(null)}
          maleData={maleData}
          femaleData={femaleData}
        />
      )}
    </div>
  );
}

/* ═══════════════════════════════════════════
   Player Profile Modal — lightweight inline version
   ═══════════════════════════════════════════ */
function PlayerProfileModal({
  player,
  onClose,
  maleData,
  femaleData,
}: {
  player: TopPlayer & { division?: string };
  onClose: () => void;
  maleData?: StatsData;
  femaleData?: StatsData;
}) {
  const playerDivision = (player.division || 'male') as 'male' | 'female';
  const dt = getDivisionTheme(playerDivision);
  const losses = player.matches - player.totalWins;
  const winRate = player.matches > 0 ? Math.round((player.totalWins / player.matches) * 100) : 0;

  // Find rank from the appropriate division's topPlayers
  const divisionData = playerDivision === 'male' ? maleData : femaleData;
  const rank = divisionData?.topPlayers?.findIndex(p => p.id === player.id) ?? -1;
  const displayRank = rank >= 0 ? rank + 1 : undefined;

  return (
    <div
      className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/80 p-0 sm:p-4"
      onClick={onClose}
      role="dialog"
      aria-modal="true"
    >
      <motion.div
        initial={{ opacity: 0, y: 40 }}
        animate={{ opacity: 1, y: 0 }}
        exit={{ opacity: 0, y: 40 }}
        className="bg-background w-full sm:max-w-md sm:rounded-2xl overflow-hidden max-h-[85vh] overflow-y-auto custom-scrollbar"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Header */}
        <div className={`relative p-5 bg-gradient-to-br ${playerDivision === 'male' ? 'from-idm-male/15 to-idm-male-light/5' : 'from-idm-female/15 to-idm-female-light/5'}`}>
          <button
            onClick={onClose}
            className="absolute top-3 right-3 w-8 h-8 rounded-full bg-background/80 flex items-center justify-center hover:bg-background transition-colors border border-border/30"
            aria-label="Tutup"
          >
            <span className="text-sm">✕</span>
          </button>

          <div className="flex items-center gap-3">
            <div className={`w-14 h-14 rounded-full overflow-hidden ring-2 ${playerDivision === 'male' ? 'ring-idm-male/30' : 'ring-idm-female/30'}`}>
              <Image
                src={getAvatarUrl(player.gamertag, playerDivision, player.avatar)}
                alt={player.gamertag}
                width={56}
                height={56}
                className="w-full h-full object-cover"
              />
            </div>
            <div>
              <h3 className="text-lg font-bold">{player.gamertag}</h3>
              <p className="text-xs text-muted-foreground">{clubToString(player.club as Parameters<typeof clubToString>[0]) || player.name || '—'}</p>
              <div className="flex items-center gap-2 mt-1">
                <TierBadge tier={player.tier} />
                <Badge className={`${dt.badgeBg} text-[8px] border`}>
                  {playerDivision === 'male' ? '🕺 Male' : '💃 Female'}
                </Badge>
                {displayRank && displayRank <= 3 && (
                  <Badge className={`text-[8px] border-0 ${
                    displayRank === 1 ? 'bg-yellow-500/20 text-yellow-500' :
                    displayRank === 2 ? 'bg-gray-400/20 text-gray-400' :
                    'bg-amber-600/20 text-amber-600'
                  }`}>
                    {displayRank === 1 ? '👑' : ''} #{displayRank}
                  </Badge>
                )}
              </div>
            </div>
          </div>
        </div>

        {/* Stats */}
        <div className="p-5">
          <div className="grid grid-cols-4 gap-2 mb-4">
            <StatItem icon={Trophy} label="Poin" value={player.points} color={dt.text} />
            <StatItem icon={Crown} label="Win Rate" value={`${winRate}%`} color="text-green-500" />
            <StatItem icon={Swords} label="W/L" value={`${player.totalWins}/${losses}`} color="text-yellow-500" />
            <StatItem icon={Flame} label="Streak" value={player.streak} color="text-orange-500" />
          </div>

          {/* Win rate bar */}
          <div className="mb-2">
            <div className="h-2 rounded-full bg-muted overflow-hidden">
              <div
                className={`h-full rounded-full transition-all duration-700 ${
                  playerDivision === 'male' ? 'bg-gradient-to-r from-idm-male to-idm-male-light' : 'bg-gradient-to-r from-idm-female to-idm-female-light'
                }`}
                style={{ width: `${winRate}%` }}
              />
            </div>
          </div>

          <p className="text-[9px] text-muted-foreground text-center">
            {player.matches} match dimainkan • {player.totalMvp}x MVP
          </p>
        </div>
      </motion.div>
    </div>
  );
}

/* Compact stat item for player profile */
function StatItem({ icon: Icon, label, value, color }: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: string | number;
  color: string;
}) {
  return (
    <div className="text-center p-2 rounded-lg bg-muted/10 border border-border/10">
      <Icon className={`w-3.5 h-3.5 ${color} mx-auto mb-1`} />
      <p className="text-sm font-bold">{value}</p>
      <p className="text-[8px] text-muted-foreground uppercase tracking-wider">{label}</p>
    </div>
  );
}

export default CommunityDashboard;
